# Copy to .env for local runs (`make run` loads it). Never commit .env.
# Deployed environments set these in the platform (Kubernetes, ECS, Lambda...),
# with secrets from the secret store.
#
# In AWS Lambda the runtime sets AWS_LAMBDA_FUNCTION_NAME, which switches the
# service to serving API Gateway HTTP API events (see docs/ARCHITECTURE.md).
# Never set it yourself.

# ---- Service
SERVICE_NAME=goservice
# local | test | staging | production
APP_ENV=local
APP_VERSION=dev

# ---- HTTP
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
# Per-request deadline; must be shorter than HTTP_WRITE_TIMEOUT.
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
# Load balancers allowed to set X-Forwarded-For (IPs/CIDRs, comma-separated).
# Empty = trust none.
HTTP_TRUSTED_PROXIES=

# ---- Logging
# debug | info | warn | error
LOG_LEVEL=info
# text is easier to read locally; deployed environments use json.
LOG_FORMAT=text

# ---- Graceful shutdown (keep SHUTDOWN_TIMEOUT below the platform's kill grace period)
SHUTDOWN_DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=25s

# ---- New Relic
# Monitoring runs only when APP_ENV=production; every other environment keeps
# the agent off, even with a key. Required in production.
NEW_RELIC_LICENSE_KEY=
# Defaults to <SERVICE_NAME>-<APP_ENV>.
NEW_RELIC_APP_NAME=
#
# Read by the agent directly (optional):
# NEW_RELIC_LABELS=team:platform;tier:backend
# Set to false if stdout logs are already shipped to New Relic another way
# (Fluent Bit, Kubernetes integration), or every line arrives twice:
# NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
# NEW_RELIC_HIGH_SECURITY=false
