              "application/json": {
                "examples": {
                  "live": {
                    "summary": "live",
                    "value": {
                      "success": true,
                      "status": 200,
                      "code": "live",
                      "message": "Service is running",
                      "data": {},
                      "requestId": "b707e5a8f62f28f2f1d1b87312db24a6"
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "code": {
                      "description": "The outcome, stable: switch on it.",
                      "enum": [
                        "live"
                      ],
                      "type": "string"
                    },
                    "data": {
                      "description": "The result: on every success, never on a failure.",
                      "maxProperties": 0,
                      "type": "object"
                    },
                    "message": {
                      "description": "A sentence for logs or people. Never parse it.",
                      "type": "string"
                    },
                    "requestId": {
                      "description": "Equal to the X-Request-ID header. Quote it when reporting a problem.",
                      "type": "string"
                    },
